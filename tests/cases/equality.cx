// `===` is the only equality operator; `==` is rejected at compile time.
console.log(1 === 1);
console.log(1 === "1");
console.log("a" === "a");
console.log(0 === false);
console.log(null === undefined);
console.log(null === null);
console.log(1 !== 2);
console.log(1 !== "1");
console.log((0 / 0) === (0 / 0));
