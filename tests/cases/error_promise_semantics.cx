// 1. finally must pass the original outcome through and ignore its own return.
Promise.resolve("v").finally(() => "ignored").then((v) => console.log("A", v));
Promise.reject("r").finally(() => "ignored").catch((e) => console.log("B", e));

// 2. Several handlers on one promise run in registration order.
const shared = Promise.resolve(1);
shared.then((v) => console.log("C", v));
shared.then((v) => console.log("D", v));

// 3. Promise.all rejects on the first rejection.
Promise.all([Promise.resolve(1), Promise.reject("bad"), Promise.resolve(3)])
  .then(() => console.log("E unreachable"))
  .catch((e) => console.log("F", e));

// 4. then returning a promise adopts it rather than nesting.
Promise.resolve(1).then(() => Promise.resolve(2)).then((v) => console.log("G", v));

// 5. A throw inside then becomes a rejection.
Promise.resolve(1).then(() => { throw "thrown"; }).catch((e) => console.log("H", e));

// 6. catch passes a value straight through.
Promise.resolve("ok").catch(() => "never").then((v) => console.log("I", v));

// 7. A rejection handled later is not "unhandled".
const late = Promise.reject("late");
setTimeout(() => late.catch((e) => console.log("J", e)), 0);
