const m = new Map();
m.set("a", 1).set("b", 2).set("a", 9);
console.log(m.size, m.get("a"), m.get("nope"), m.has("b"), m.has("z"));
console.log(m);
for (const [k, v] of m) console.log(k, v);
console.log(m.delete("a"), m.delete("a"), m.size);
console.log([...m.keys()].join(","), [...m.values()].join(","));

const s = new Set([3, 1, 3, 2]);
console.log(s.size, s.has(3), s.has(9));
console.log(s);
for (const v of s) console.log("v", v);
console.log([...s].join(","));

const withPairs = new Map([["x", 10], ["y", 20]]);
console.log(withPairs.size, withPairs.get("y"));
withPairs.forEach((v, k) => console.log("each", k, v));

// NaN and -0 follow SameValueZero.
const odd = new Map();
odd.set(NaN, "nan").set(-0, "zero");
console.log(odd.get(NaN), odd.get(0), odd.size);

// Objects are keyed by identity.
const k1 = { id: 1 };
const k2 = { id: 1 };
const byIdentity = new Map([[k1, "first"]]);
console.log(byIdentity.get(k1), byIdentity.get(k2));

const big = new Map();
for (let i = 0; i < 500; i++) big.set(i, i * 2);
for (let i = 0; i < 250; i++) big.delete(i);
console.log(big.size, big.get(499), big.get(0));
