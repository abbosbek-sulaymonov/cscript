// A property the compiler was told holds a number, holding something else. The
// entry check refuses, the interpreter runs the body, and what a program sees
// is the interpreter's answer — which for a string times a number is a refusal,
// because CScript does not coerce. The compiler changes none of that.
function dot(a, b) {
  return a.x * b.x + a.y * b.y;
}

const unit = { x: 3, y: 4 };
let total = 0;
for (let i = 0; i < 200; i++) {
  total = total + dot(unit, unit);
}
console.log(total);

dot({ x: "three", y: 4 }, unit);
