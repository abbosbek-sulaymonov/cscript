// `===` is the only equality operator; `==` is rejected at compile time.
console.log(1 === 1);
console.log("a" === "a");
console.log(null === undefined);
console.log(null === null);
console.log(1 !== 2);
console.log((0 / 0) === (0 / 0));

// Comparing two different types is a compile error when the checker can see
// both. A `value` is the exception, and deliberately so: asking what one holds
// is what `===` is for there, and it is how the runtime rule stays observable.
const n: unknown = 1;
const s: unknown = "1";
const f: unknown = false;
console.log(n === s);
console.log(0 === f);
console.log(n !== s);
