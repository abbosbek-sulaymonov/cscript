// A shape checked where it is used, rather than once at entry.
//
// An entry assumption is the cheapest check there is — one per call, for a
// slot the caller filled — and it is still what a parameter's property read
// uses. What it cannot speak for is a slot the *body* writes: an object built
// inside the function holds nothing at entry, so the assumption failed on
// every single call and the whole call was interpreted for the sake of a check
// that could never have held.
//
// A guard at the read says the same thing where it is true. When it does not
// hold the frame goes back to the interpreter at the property instruction,
// which then does the read its own way.

// The plain shape: an object built here, read here.
function boxed(n: number): number {
  const made = { a: n, b: n + 1 };
  return made.a + made.b;
}

let sum: number = 0;
for (let i: number = 0; i < 30000; i = i + 1) {
  sum = sum + boxed(i % 7);
}
console.log(sum);

// Two layouts through one read, so the guard actually fails — on about half
// the calls, and the answers have to agree with the interpreter on both sides.
function pick(n: number): number {
  let o = { a: n, b: n + 1 };
  if (n % 2 === 0) {
    o = { a: n * 10, b: n, c: n };
  }
  return o.a + o.b;
}

let picked: number = 0;
for (let i: number = 0; i < 30000; i = i + 1) {
  picked = picked + pick(i % 9);
}
console.log(picked);

// A read through a parameter keeps the entry assumption: the caller filled
// that slot and the body never writes it, so one check per call is right.
interface Point {
  x: number;
  y: number;
}

function reach(point: Point): number {
  return point.x * point.y;
}

const fixed: Point = { x: 3, y: 4 };
let reached: number = 0;
for (let i: number = 0; i < 30000; i = i + 1) {
  reached = reached + reach(fixed);
}
console.log(reached);

// Both in one body: `this` is a slot the caller filled, `scratch` is one this
// body wrote, so the method carries an entry assumption and a guard at once.
class Gauge {
  base: number;

  constructor(base: number) {
    this.base = base;
  }

  step(n: number): number {
    const scratch = { lo: n, hi: n + this.base };
    return scratch.lo + scratch.hi + this.base;
  }
}

const gauge = new Gauge(5);
let stepped: number = 0;
for (let i: number = 0; i < 30000; i = i + 1) {
  stepped = stepped + gauge.step(i % 11);
}
console.log(stepped);

// A property that is not in the object's own storage names no layout to guard
// on: `toFixed` is reached through a prototype, and what the cache recorded is
// that the shape does not have it. That used to refuse the whole function; now
// it hands the frame back at that instruction and the rest still compiles.
function viaPrototype(n: number): string {
  const scaled = n * 2 + 1;
  return scaled.toFixed(2);
}

console.log(viaPrototype(4), viaPrototype(7));

// The objects the guarded reads run on are real, and survive being handed back.
const kept = [];
for (let i = 0; i < 40; i++) {
  kept.push({ a: i, b: i * 3 });
}
console.log(kept.length, kept[0].a, kept[39].b, JSON.stringify(kept[9]));
