// `enum` — the one declaration here that is a type and a value at once.
//
// Node's type stripping refuses an enum, so what this is checked against is
// `tsc`: the expectation below is what TypeScript's own emit prints.
//
// Everything else the type grammar declares is erased. An enum cannot be,
// because `Color.Red` has to answer something at run time, so it compiles to
// the object TypeScript emits for one — the names to their values, and, for a
// numeric member, the value back to its name.

enum Color {
  Red,
  Green,
  Blue,
}

console.log(Color.Red, Color.Green, Color.Blue);

// The reverse half, which is how a program prints one.
console.log(Color[0], Color[1], Color[2]);

// Counting resumes from whatever was written down.
enum Level {
  Low = 1,
  Medium,
  High = 10,
  Higher,
}

console.log(Level.Low, Level.Medium, Level.High, Level.Higher);
console.log(Level[2], Level[11]);

// A string enum has no reverse half: a member's value could collide with a
// name. What it has instead is an exact type — the union of its values.
enum Direction {
  Up = "up",
  Down = "down",
}

console.log(Direction.Up, Direction.Down);

function go(d: Direction): string {
  return "going " + d;
}
console.log(go(Direction.Up), go(Direction.Down));

// Negative and non-consecutive members.
enum Signal {
  Stop = -1,
  Go = 1,
}
console.log(Signal.Stop, Signal.Go, Signal[-1], Signal[1]);

// Compared and switched on, which is most of what an enum is for.
function colorName(c: Color): string {
  if (c === Color.Red) return "red";
  if (c === Color.Green) return "green";
  return "blue";
}
console.log(colorName(Color.Red), colorName(Color.Green), colorName(Color.Blue));

function shortName(d: Direction): string {
  switch (d) {
    case Direction.Up:
      return "u";
    default:
      return "d";
  }
}
console.log(shortName(Direction.Up), shortName(Direction.Down));

// The object it compiles to is an ordinary one, so it iterates like one.
const keys = Object.keys(Direction);
console.log(keys.join(","), JSON.stringify(Direction));

// Held in a variable, passed around, and used as a key.
const chosen: Direction = Direction.Down;
const counts = { up: 0, down: 0 };
counts[chosen] = counts[chosen] + 3;
console.log(chosen, counts.down);
