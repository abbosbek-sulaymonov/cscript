import { Range, range, inclusive } from "std:range";
import { equal, deepEqual, ok, notOk, messageOf, throws } from "std:assert";

const r = range(1, 5);
equal(r.start, 1);
equal(r.end, 5, "exclusive, like every slice");
equal(r.last, 4, "which is what a reader means by the end");
equal(r.length, 4);
notOk(r.isEmpty);
deepEqual(r.toArray(), [1, 2, 3, 4]);
deepEqual([...r], [1, 2, 3, 4], "and it can be walked twice, unlike a generator");
deepEqual([...r], [1, 2, 3, 4]);

ok(r.contains(1)); ok(r.contains(4)); notOk(r.contains(5)); notOk(r.contains(0));
ok(r.containsRange(range(2, 4)));
notOk(r.containsRange(range(0, 2)));
ok(r.containsRange(range(3, 3)), "an empty range is inside anything");

ok(r.overlaps(range(4, 9)));
notOk(r.overlaps(range(5, 9)), "the end is exclusive on both sides");
notOk(r.overlaps(range(2, 2)));

equal(r.clamp(9), 4);
equal(r.clamp(-1), 1);
equal(r.clamp(2), 2);
equal(messageOf(throws(() => range(2, 2).clamp(1))),
      "cannot clamp against an empty range");

ok(r.intersect(range(3, 9)).equals(range(3, 5)));
ok(r.intersect(range(9, 10)).isEmpty);
ok(r.union(range(8, 10)).equals(range(1, 10)), "and it holds what sits between");
ok(r.union(range(3, 3)).equals(r));
ok(r.shifted(10).equals(range(11, 15)));
ok(r.grown(1).equals(range(0, 6)));
ok(r.grown(-2).equals(range(3, 3)), "narrowing cannot go past empty");

ok(inclusive(1, 3).equals(range(1, 4)));
deepEqual(inclusive(1, 3).toArray(), [1, 2, 3]);
ok(Range.ofLength(5, 3).equals(range(5, 8)));
ok(Range.covering([4, 1, 7]).equals(range(1, 8)));
equal(messageOf(throws(() => Range.covering([]))), "Range.covering of nothing");
equal(messageOf(throws(() => new Range("a", 2))), "a Range needs two numbers");

const empty = range(5, 5);
ok(empty.isEmpty);
equal(empty.length, 0);
deepEqual(empty.toArray(), []);
ok(empty.equals(range(9, 9)), "one empty range is like another");
equal(range(5, 1).length, 0, "a backwards range is empty, not negative");

equal(String(r), "Range(1, 5)");

console.log(String(r), r.toArray(), r.last);
console.log(String(r.intersect(range(3, 9))), String(r.union(range(8, 10))));
console.log(String(inclusive(0, 2)), String(Range.covering([9, 2, 5])));
console.log("range ok");
