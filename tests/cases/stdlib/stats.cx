import { sum, product, mean, median, mode, min, max, spread, variance,
         populationVariance, stdev, populationStdev, quantile, percentile,
         clamp, lerp, normalize, round, describe, cumulativeSum, zScores } from "std:stats";
import { equal, deepEqual, closeTo, throws, messageOf } from "std:assert";

equal(sum([1, 2, 3]), 6); equal(sum([]), 0);
equal(product([2, 3, 4]), 24);
equal(mean([1, 2, 3, 4]), 2.5);
equal(median([3, 1, 2]), 2); equal(median([4, 1, 3, 2]), 2.5);
const source = [3, 1, 2]; median(source); deepEqual(source, [3, 1, 2]);
deepEqual(mode([1, 2, 2, 3]), [2]); deepEqual(mode([1, 1, 2, 2]), [1, 2]);
equal(min([3, 1, 2]), 1); equal(max([3, 1, 2]), 3); equal(spread([3, 1, 2]), 2);
equal(variance([2, 4, 4, 4, 5, 5, 7, 9]), 4.571428571428571);
equal(populationVariance([2, 4, 4, 4, 5, 5, 7, 9]), 4);
equal(populationStdev([2, 4, 4, 4, 5, 5, 7, 9]), 2);
closeTo(stdev([2, 4, 4, 4, 5, 5, 7, 9]), 2.13808993529939, 1e-12);
equal(quantile([1, 2, 3, 4], 0.5), 2.5);
equal(quantile([1, 2, 3, 4], 0), 1); equal(quantile([1, 2, 3, 4], 1), 4);
equal(percentile([1, 2, 3, 4], 25), 1.75);
equal(clamp(5, 1, 3), 3); equal(clamp(0, 1, 3), 1); equal(clamp(2, 1, 3), 2);
equal(lerp(0, 10, 0.5), 5); equal(lerp(0, 10, 2), 20);
equal(normalize(5, 0, 10), 0.5);
equal(round(1.2345, 2), 1.23); equal(round(1.5), 2);
deepEqual(describe([1, 2, 3]), { count: 3, min: 1, max: 3, mean: 2, median: 2, stdev: 1 });
deepEqual(cumulativeSum([1, 2, 3]), [1, 3, 6]);
deepEqual(zScores([1, 2, 3]), [-1, 0, 1]);
equal(messageOf(throws(() => mean([]))), "mean of an empty sequence");
equal(messageOf(throws(() => mean([1, "x"]))), "mean needs numbers, and was given string");
equal(messageOf(throws(() => variance([1]))), "variance needs at least two values");
equal(messageOf(throws(() => quantile([1], 2))), "a quantile is between 0 and 1, and was given 2");
/* Printed field by field rather than as one object: Node's console.log breaks
 * a wide object across lines and CScript's keeps it on one, which is a
 * difference in the printer rather than in anything here. */
const sample = [2, 4, 4, 4, 5, 5, 7, 9];
const summary = describe(sample);
console.log(summary.count, summary.min, summary.max, summary.mean, summary.median);
console.log(round(summary.stdev, 6));
console.log(quantile(sample, 0.25), quantile(sample, 0.75));
console.log("stats ok");
