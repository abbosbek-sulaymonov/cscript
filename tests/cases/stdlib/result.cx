import { Result, Option } from "std:result";
import { equal, deepEqual, ok, throws, messageOf } from "std:assert";

const good = Result.ok(2);
const bad = Result.err("nope");
ok(good.isOk); ok(bad.isErr);
equal(good.value, 2); equal(bad.error, "nope");
equal(good.map((x: number) => x * 3).value, 6);
equal(bad.map((x: number) => x * 3).isErr, true);
equal(bad.mapErr((e: string) => e + "!").error, "nope!");
equal(good.andThen((x: number) => Result.ok(x + 1)).value, 3);
equal(good.andThen((x: number) => Result.err("later")).isErr, true);
equal(bad.orElse((e: string) => Result.ok(0)).value, 0);
equal(good.unwrapOr(9), 2); equal(bad.unwrapOr(9), 9);
equal(bad.unwrapOrElse((e: string) => e.length), 4);
equal(good.match((v: number) => "ok " + String(v), (e: unknown) => "err"), "ok 2");
equal(String(good), "Ok(2)"); equal(String(bad), "Err(nope)");
equal(messageOf(throws(() => bad.value)), "read the value of an error Result");
equal(messageOf(throws(() => good.error)), "read the error of an ok Result");
const parsed = Result.attempt(() => { throw new Error("bad input"); });
ok(parsed.isErr);
equal(Result.attempt(() => 5).value, 5);
deepEqual(Result.all([Result.ok(1), Result.ok(2)]).value, [1, 2]);
equal(Result.all([Result.ok(1), Result.err("x")]).error, "x");
equal(good.toOption().isSome, true);

const some = Option.some(3);
const none = Option.none();
ok(some.isSome); ok(none.isNone);
equal(some.map((x: number) => x + 1).value, 4);
equal(some.filter((x: number) => x > 5).isNone, true);
equal(none.unwrapOr(7), 7);
equal(none.unwrapOrElse(() => 8), 8);
equal(none.orElse(() => Option.some(1)).value, 1);
equal(Option.from(null).isNone, true);
equal(Option.from(0).value, 0);
equal(some.andThen((x: number) => Option.some(x * 2)).value, 6);
equal(some.match((v: number) => v, () => -1), 3);
equal(none.toResult("missing").error, "missing");
deepEqual([...some], [3]); deepEqual([...none], []);
equal(String(some), "Some(3)"); equal(String(none), "None");
const halve = (n: number) => n % 2 === 0 ? Result.ok(n / 2) : Result.err("odd");
console.log(String(halve(8).map((n: number) => n + 1)), String(halve(7)));
console.log(String(Option.from(null).orElse(() => Option.some("fallback"))));
console.log("result ok");
