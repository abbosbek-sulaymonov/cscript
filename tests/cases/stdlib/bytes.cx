/* Node cannot be the oracle for this case, and the reason is the module's whole
 * subject: a CScript string is **bytes** and a Node string is UTF-16 code
 * units, so `"é".charCodeAt(0)` is 195 here and 233 there. Every assertion
 * involving anything outside ASCII therefore disagrees by design. The expected
 * output was produced by CScript and checked against the module README.
 */
import { fromString, toString, of, alloc, concat, isBytes, equals, compare,
         equalsConstantTime, slice, indexOf, includes, startsWith, endsWith,
         readUint8, readUint16BE, readUint16LE, readUint32BE, readUint32LE,
         readInt32BE, readInt32LE, writeUint8, writeUint16BE, writeUint16LE,
         writeUint32BE, writeUint32LE } from "std:bytes";
import { equal, deepEqual, ok, notOk, throws, messageOf } from "std:assert";

/* A CScript string is already bytes, so both directions are exact. */
deepEqual(fromString("Hi"), [72, 105]);
equal(toString([72, 105]), "Hi");
equal(toString(fromString("café")), "café", "including what is not ASCII");
deepEqual(fromString("é"), [195, 169], "which is two bytes");
equal(toString([]), "");

deepEqual(of(1, 2, 3), [1, 2, 3]);
deepEqual(alloc(3), [0, 0, 0]);
deepEqual(alloc(2, 255), [255, 255]);
deepEqual(concat([1], [2, 3], []), [1, 2, 3]);

ok(isBytes([0, 255]));
notOk(isBytes([256]));
notOk(isBytes([-1]));
notOk(isBytes([1.5]));
notOk(isBytes("not an array"));
equal(messageOf(throws(() => of(300))), "byte 0 is not a whole number from 0 to 255: 300");

ok(equals([1, 2], [1, 2]));
notOk(equals([1], [1, 2]));
equal(compare([1, 2], [1, 3]), -1);
equal(compare([1, 2], [1, 2]), 0);
equal(compare([1], [1, 0]), -1, "a prefix comes first");
ok(equalsConstantTime([1, 2], [1, 2]));
notOk(equalsConstantTime([1, 2], [1, 3]));

deepEqual(slice([1, 2, 3, 4], 1, 3), [2, 3]);
deepEqual(slice([1, 2, 3], 1), [2, 3]);
equal(indexOf(fromString("hello"), fromString("ll")), 2);
equal(indexOf(fromString("hello"), fromString("z")), -1);
equal(indexOf(fromString("aaa"), fromString("a"), 1), 1);
ok(includes(fromString("hello"), fromString("ell")));
ok(startsWith(fromString("hello"), fromString("he")));
ok(endsWith(fromString("hello"), fromString("lo")));
notOk(startsWith([1], [1, 2]), "a prefix longer than the whole is not one");

/* Numbers at an offset, which is what a binary format is made of. */
const buffer = alloc(8);
writeUint8(buffer, 0, 200);
writeUint16BE(buffer, 1, 65535);
writeUint16LE(buffer, 3, 258);
equal(readUint8(buffer, 0), 200);
equal(readUint16BE(buffer, 1), 65535);
equal(readUint16LE(buffer, 3), 258);
deepEqual(slice(buffer, 3, 5), [2, 1], "little-endian puts the low byte first");

const wide = alloc(4);
writeUint32BE(wide, 0, 3735928559);
deepEqual(wide, [222, 173, 190, 239]);
equal(readUint32BE(wide, 0), 3735928559);
equal(readInt32BE(wide, 0), -559038737, "the same four bytes, read as signed");
writeUint32LE(wide, 0, 3735928559);
deepEqual(wide, [239, 190, 173, 222]);
equal(readUint32LE(wide, 0), 3735928559);
equal(readInt32LE(wide, 0), -559038737);
equal(readInt32BE([0, 0, 0, 1], 0), 1);

/* Reading past the end is a mistake, not an answer full of undefined. */
equal(messageOf(throws(() => readUint32BE([1, 2], 0))),
      "reading 4 bytes at 0 is outside a sequence of 2");
equal(messageOf(throws(() => readUint8([1], 1))),
      "reading 1 bytes at 1 is outside a sequence of 1");
equal(messageOf(throws(() => writeUint16BE(alloc(2), 0, 70000))),
      "value is not a whole number from 0 to 65535: 70000");

console.log(fromString("Hi"), toString([104, 105]));
console.log(readUint32BE([222, 173, 190, 239], 0), readInt32BE([222, 173, 190, 239], 0));
console.log("bytes ok");
