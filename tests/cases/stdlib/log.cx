import { Logger, DEBUG, INFO, WARN, ERROR, SILENT, levelNamed, levelName,
         base } from "std:log";
import { equal, deepEqual, ok, notOk } from "std:assert";

/* The clock is injectable so a golden test can check the output at all. */
const lines = [];
const at = () => 1700000000000;
const log = new Logger({ write: (line: string) => lines.push(line), clock: at });

log.info("started");
log.debug("not shown at the default level");
log.warn("slow", { ms: 1200 });
log.error("failed", { path: "/tmp/x", message: "two words" });

deepEqual(lines, [
  "2023-11-14T22:13:20.000Z info  started",
  "2023-11-14T22:13:20.000Z warn  slow ms=1200",
  "2023-11-14T22:13:20.000Z error failed path=/tmp/x message=\"two words\"",
]);

/* A level turns lines off without deleting them. */
const quiet = [];
const quietLog = new Logger({ level: WARN, write: (l: string) => quiet.push(l),
                              time: false });
quietLog.debug("no"); quietLog.info("no"); quietLog.warn("yes"); quietLog.error("yes");
deepEqual(quiet, ["warn  yes", "error yes"]);
notOk(quietLog.enabled(INFO));
ok(quietLog.enabled(ERROR));

const silent = [];
const silentLog = new Logger({ level: SILENT, write: (l: string) => silent.push(l) });
silentLog.error("nothing gets through");
deepEqual(silent, []);

quietLog.setLevel(DEBUG);
ok(quietLog.enabled(DEBUG));

/* A child logger carries its fields without being told again. */
const child = [];
const parent = new Logger({ write: (l: string) => child.push(l), time: false });
const request = parent.with({ requestId: "abc" });
request.info("received");
request.with({ step: 2 }).info("continued", { extra: true });
deepEqual(child, [
  "info  received requestId=abc",
  "info  continued requestId=abc step=2 extra=true",
]);

/* JSON, for anything that will be searched later. Field order is fixed. */
const structured = [];
const jsonLog = new Logger({ format: "json", clock: at,
                             write: (l: string) => structured.push(l) });
jsonLog.info("saved", { bytes: 12, ok: true, note: null, quoted: "a \"b\"" });
deepEqual(structured, [
  '{"time":"2023-11-14T22:13:20.000Z","level":"info","message":"saved",' +
  '"bytes":12,"ok":true,"note":null,"quoted":"a \\"b\\""}',
]);

const noTime = [];
new Logger({ format: "json", time: false, write: (l: string) => noTime.push(l) })
    .warn("terse");
deepEqual(noTime, ['{"level":"warn","message":"terse"}']);

equal(levelNamed("debug"), DEBUG);
equal(levelNamed("WARN"), WARN);
equal(levelNamed("warning"), WARN);
equal(levelNamed("off"), SILENT);
equal(levelNamed("nonsense"), -1, "which a caller can tell from a deliberate silent");
equal(levelName(INFO), "info");
equal(levelName(999), "log");

equal(base.level, INFO, "the ready-made one is info and above");

console.log(lines.join("\n"));
console.log(structured[0]);
console.log("log ok");
