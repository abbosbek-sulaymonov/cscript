import { compareNumbers, compareStrings, compareStringsInsensitive, compareBooleans,
         compare, by, byDescending, reversed, then, nullsFirst, nullsLast,
         minBy, maxBy, isSorted } from "std:cmp";
import { equal, deepEqual, ok, notOk } from "std:assert";

equal(compareNumbers(1, 2), -1);
equal(compareNumbers(2, 1), 1);
equal(compareNumbers(1, 1), 0);
/* Not a - b: the subtraction would overflow and NaN would sort unpredictably. */
equal(compareNumbers(1e308, -1e308), 1);

equal(compareStrings("a", "b"), -1);
equal(compareStrings("b", "a"), 1);
equal(compareStrings("a", "a"), 0);
equal(compareStrings("ab", "abc"), -1, "a prefix comes first");
equal(compareStrings("Z", "a"), -1, "by byte, so capitals sort first");
equal(compareStringsInsensitive("a", "B"), -1);
equal(compareStringsInsensitive("a", "A"), 1, "ties break by case-sensitive order");
equal(compareBooleans(false, true), -1, "unfinished work first");

equal(compare(1, 2), -1);
equal(compare("a", "b"), -1);
equal(compare(false, true), -1);

/* The built-in sort with no comparator sorts strings the same way. */
deepEqual(["pear", "apple", "Fig"].sort(compareStrings), ["pear", "apple", "Fig"].sort());

const people: any = [{ name: "bea", age: 30 }, { name: "ann", age: 30 },
                     { name: "cal", age: 20 }];
deepEqual(people.slice(0).sort(by((p: any) => p.age)).map((p: any) => p.name),
          ["cal", "bea", "ann"]);
deepEqual(people.slice(0).sort(then(by((p: any) => p.age), by((p: any) => p.name)))
              .map((p: any) => p.name), ["cal", "ann", "bea"]);
deepEqual(people.slice(0).sort(byDescending((p: any) => p.age)).map((p: any) => p.age),
          [30, 30, 20]);
deepEqual([3, 1, 2].sort(reversed(compareNumbers)), [3, 2, 1]);

/* `undefined` is sorted to the end by the runtime before any comparator runs
 * — the specification's rule, and Node's — so only `null` can be moved to the
 * front by a comparator. */
deepEqual([3, null, 1].sort(nullsFirst()), [null, 1, 3]);
deepEqual([3, null, 1].sort(nullsLast()), [1, 3, null]);
deepEqual([3, undefined, 1].sort(nullsFirst()), [1, 3, undefined]);

equal(minBy([3, 1, 2]), 1);
equal(maxBy([3, 1, 2]), 3);
equal(minBy(["pear", "apple"]), "apple");
equal(minBy([]), undefined, "the smallest of nothing is nothing");
equal(maxBy(people, by((p: any) => p.age)).age, 30);

ok(isSorted([1, 2, 2, 3]));
notOk(isSorted([2, 1]));
ok(isSorted(["a", "b"]));
ok(isSorted([]));

console.log(["pear", "apple", "Fig"].sort(compareStrings));
console.log(people.slice(0).sort(then(by((p: any) => p.age), by((p: any) => p.name)))
                .map((p: any) => p.name));
console.log("cmp ok");
