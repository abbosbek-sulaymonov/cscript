/* kind.cx — what a value actually is.
 *
 * `typeof` answers "object" for an object, an array, a Map, a Set, a Date and
 * a class instance alike. That is a problem rather than an inconvenience,
 * because nothing else in the language can separate them either: every
 * `Object` method that would tell you — `keys`, `entries`, `getPrototypeOf`,
 * `hasOwn` — *refuses* a Map rather than answering about it, and a refusal is
 * an uncatchable runtime error. So a function that walks a value structurally
 * had no safe way to ask what it was walking.
 *
 * `Object.kindOf` is the built-in that answers, and this module is the names
 * and the predicates over it.
 *
 * ## Why the fallback below exists
 *
 * The library is checked against Node — every expected file in
 * tests/cases/stdlib is generated by running the same program there. Node has
 * no `Object.kindOf`, but it does have the prototype tag that CScript lacks,
 * and the two answer the same question. So this module asks whichever is
 * available, which is what lets the modules built on it stay Node-checkable.
 */

/* The kind of anything, as one of:
 *
 *   "null" "undefined" "boolean" "number" "bigint" "string" "symbol"
 *   "function" "class" "array" "object" "instance" "map" "set" "weakmap"
 *   "weakset" "date" "regex" "promise" "generator"
 *
 * "object" is a plain object and "instance" is one with a class, because that
 * is the distinction a structural walk needs. */
export function kindOf(value: value): string {
  if (typeof Object.kindOf === "function") return Object.kindOf(value);
  return nodeKind(value);
}

/* Node's answer to the same question. `Object.prototype.toString.call(x)` is
 * "[object Map]" and the like — the tag CScript does not carry. Unreachable
 * under CScript, where the built-in above answers first. */
function nodeKind(value: value): string {
  if (value === null) return "null";
  if (value === undefined) return "undefined";

  const basic = typeof value;
  if (basic !== "object" && basic !== "function") return basic;

  const tag = Object.prototype.toString.call(value).slice(8, -1).toLowerCase();
  if (basic === "function") {
    /* A class under Node is a function whose source begins with `class`. */
    return String(value).startsWith("class ") ? "class" : "function";
  }
  if (tag === "array") return "array";
  if (tag === "map" || tag === "set" || tag === "weakmap" || tag === "weakset") return tag;
  if (tag === "date" || tag === "regexp" || tag === "promise") {
    return tag === "regexp" ? "regex" : tag;
  }
  if (tag === "generator") return "generator";
  if (Object.getPrototypeOf(value) === Object.prototype ||
      Object.getPrototypeOf(value) === null) {
    return "object";
  }
  return "instance";
}

/* --- the predicates a walk actually asks ---------------------------------- */

/* The one that matters most: can this be walked with `Object.keys`?
 *
 * True only for a plain object — not an array, not a Map, not an instance.
 * Every structural function in the library asks this before walking, because
 * asking wrongly is a crash rather than a wrong answer. */
export function isPlainObject(value: value): boolean {
  return kindOf(value) === "object";
}

export function isArray(value: value): boolean {
  return kindOf(value) === "array";
}

export function isMap(value: value): boolean {
  return kindOf(value) === "map";
}

export function isSet(value: value): boolean {
  return kindOf(value) === "set";
}

export function isWeak(value: value): boolean {
  const kind = kindOf(value);
  return kind === "weakmap" || kind === "weakset";
}

export function isDate(value: value): boolean {
  return kindOf(value) === "date";
}

export function isRegex(value: value): boolean {
  return kindOf(value) === "regex";
}

export function isPromise(value: value): boolean {
  return kindOf(value) === "promise";
}

export function isGenerator(value: value): boolean {
  return kindOf(value) === "generator";
}

export function isInstance(value: value): boolean {
  return kindOf(value) === "instance";
}

export function isFunction(value: value): boolean {
  const kind = kindOf(value);
  return kind === "function" || kind === "class";
}

/* A number, string, boolean, bigint, symbol, null or undefined — anything with
 * no interior to walk. */
export function isPrimitive(value: value): boolean {
  const kind = kindOf(value);
  return kind === "number" || kind === "string" || kind === "boolean" ||
         kind === "bigint" || kind === "symbol" || kind === "null" ||
         kind === "undefined";
}

/* Something a structural walk can take apart: a plain object or an array. */
export function isWalkable(value: value): boolean {
  const kind = kindOf(value);
  return kind === "object" || kind === "array";
}

/* Something with a `size` and an iterator: a Map or a Set, but not a weak one,
 * which cannot be iterated at all. */
export function isCollection(value: value): boolean {
  const kind = kindOf(value);
  return kind === "map" || kind === "set";
}
