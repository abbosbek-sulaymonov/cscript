/* os.cx — what the program can learn about where it is running.
 *
 * Over the `process` built-in, with the parts a script actually asks for given
 * names of their own: the arguments it was passed rather than the argv Node
 * shape, the home and temporary directories rather than the environment
 * variables they hide behind, and the platform as a question rather than a
 * string to compare against.
 *
 * What is absent: the hostname, the user, the load, the memory. None is in the
 * runtime, and each would need a native of its own — worth adding when
 * something needs them, not before.
 */
import { Option } from "std:result";

/* --- the environment ------------------------------------------------------ */

/* `undefined` for a variable nothing set, or the fallback when one is given.
 * `process.env` is a function rather than an object for the reason this
 * matters: reading an absent property is a runtime error in CScript, so
 * `process.env.HOME` would crash on a machine that did not set it. */
export function env(name: string, fallback: value = undefined) {
  const value = process.env(name);
  return value === undefined ? fallback : value;
}

/* The same lookup as an Option, for the code that would rather match than
 * compare against undefined. */
export function envOption(name: string) {
  return Option.from(process.env(name));
}

export function hasEnv(name: string): boolean {
  return process.env(name) !== undefined;
}

export function envNames() {
  const names = process.envNames();
  names.sort();
  return names;
}

/* The whole environment as a Map, built one lookup at a time. A Map rather
 * than an object so that walking it is ordinary iteration, and so that a name
 * that happens to be `toString` is not a surprise. */
export function envAll() {
  const all = new Map();
  for (const name of envNames()) all.set(name, process.env(name));
  return all;
}

/* --- where ---------------------------------------------------------------- */

export function cwd(): string {
  return process.cwd();
}

/* HOME on every platform this runs on; USERPROFILE is what Windows calls it,
 * and is checked so the answer is not empty there. */
export function homeDir() {
  return env("HOME") ?? env("USERPROFILE");
}

/* The first of the three names in use, then /tmp — which is where they all
 * point anyway on anything but Windows. */
export function tempDir(): string {
  return env("TMPDIR") ?? env("TMP") ?? env("TEMP") ?? "/tmp";
}

/* --- which platform ------------------------------------------------------- */

export function platform(): string {
  return process.platform;
}

export function isMac(): boolean {
  return process.platform === "darwin";
}

export function isLinux(): boolean {
  return process.platform === "linux";
}

export function isWindows(): boolean {
  return process.platform === "win32";
}

/* The separators that differ by platform, as values rather than as an `if` at
 * every use. */
export function pathSeparator(): string {
  return isWindows() ? "\\" : "/";
}

export function pathListSeparator(): string {
  return isWindows() ? ";" : ":";
}

export function lineEnding(): string {
  return isWindows() ? "\r\n" : "\n";
}

/* --- this process --------------------------------------------------------- */

export function pid(): number {
  return process.pid;
}

/* What the *script* was given, without the executable and the script path that
 * `process.argv` carries in front for Node's sake. This is what a program
 * parsing its own options wants. */
export function args() {
  const all = process.argv;
  return all.length > 2 ? all.slice(2) : [];
}

export function scriptPath() {
  const all = process.argv;
  return all.length > 1 ? all[1] : undefined;
}

export function executablePath() {
  const all = process.argv;
  return all.length > 0 ? all[0] : undefined;
}

/* Ends the program now: no pending timers, no queued microtasks. A program
 * that wants its outstanding work finished should return from the top level
 * instead. */
export function exit(code: number = 0) {
  process.exit(code);
}
