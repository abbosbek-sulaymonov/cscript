/* iter.cx — sequences, one element at a time.
 *
 * Everything here takes anything `for...of` accepts — an array, a string, a
 * Map, a Set, another generator — and everything that produces a sequence is a
 * generator, so nothing is built that nobody asks for. `take(count(), 5)`
 * finishes; `[...count()]` does not, and that is the caller's choice to make.
 *
 * Which is also the rule for reading this file: a function that returns a
 * generator has done no work when it returns. Nothing runs until the sequence
 * is walked, and walking it twice walks the source twice — a generator, unlike
 * an array, is used up once it has been read.
 */

/* --- making a sequence --------------------------------------------------- */

/* `range(4)` is 0..3, `range(1, 4)` is 1..3, `range(4, 0, -1)` counts down.
 * The one-argument form is the common one, so it is the one that reads as a
 * length rather than as a bound. */
/* The one-argument form is the common one, so a stop that was not given is a
 * sentinel rather than undefined: the bound is a number from the first line,
 * which is what lets the loops below be plain comparisons. */
export function* range(start: number, stop: number = Infinity, step: number = 1) {
  let from = start;
  let to = stop;
  if (to === Infinity) {
    to = start;
    from = 0;
  }

  if (step === 0) throw new Error("range needs a non-zero step");
  if (step > 0) {
    for (let i = from; i < to; i = i + step) yield i;
  } else {
    for (let i = from; i > to; i = i + step) yield i;
  }
}

/* Unbounded. Pair it with `take`, or with a `break`. */
export function* count(start: number = 0, step: number = 1) {
  let value = start;
  while (true) {
    yield value;
    value = value + step;
  }
}

/* `times` below zero repeats for ever, which is what makes `repeat(x)` a
 * sensible thing to write at all. */
export function* repeat(value: unknown, times: number = -1) {
  if (times < 0) {
    while (true) yield value;
  }
  for (let i = 0; i < times; i++) yield value;
}

export function* cycle(iterable: unknown) {
  const seen = [];
  for (const element of iterable) {
    seen.push(element);
    yield element;
  }
  if (seen.length === 0) return;
  while (true) {
    for (const element of seen) yield element;
  }
}

/* --- reshaping one -------------------------------------------------------- */

/* CScript checks arity, so handing an index to a one-parameter arrow is an
 * error rather than an ignored extra argument. A callback is therefore asked
 * how many parameters it declared and called with that many — which is exactly
 * what the built-in array methods do, so `map` here and `map` there behave the
 * same way for the same callback. */
function callIndexed(callback: Function, element: unknown, index: number) {
  if (callback.length >= 2) return callback(element, index);
  return callback(element);
}

export function* map(iterable: unknown, transform: Function) {
  let index = 0;
  for (const element of iterable) {
    yield callIndexed(transform, element, index);
    index = index + 1;
  }
}

export function* filter(iterable: unknown, keep: Function) {
  let index = 0;
  for (const element of iterable) {
    if (callIndexed(keep, element, index)) yield element;
    index = index + 1;
  }
}

export function* take(iterable: unknown, howMany: number) {
  if (howMany <= 0) return;
  let taken = 0;
  for (const element of iterable) {
    yield element;
    taken = taken + 1;
    if (taken >= howMany) return;
  }
}

export function* drop(iterable: unknown, howMany: number) {
  let dropped = 0;
  for (const element of iterable) {
    if (dropped < howMany) {
      dropped = dropped + 1;
      continue;
    }
    yield element;
  }
}

export function* takeWhile(iterable: unknown, keep: Function) {
  for (const element of iterable) {
    if (!keep(element)) return;
    yield element;
  }
}

export function* dropWhile(iterable: unknown, skip: Function) {
  let dropping = true;
  for (const element of iterable) {
    if (dropping && skip(element)) continue;
    dropping = false;
    yield element;
  }
}

/* Anything iterable as a generator, which is the only handle CScript gives on
 * "one element at a time from a source I did not create" — a generator object
 * answers `next()`, and an array or a string does not. */
function* asStream(iterable: unknown) {
  for (const element of iterable) yield element;
}

/* Stops with the shorter, which is the only answer that needs no filler.
 *
 * Pulls from both one element at a time rather than collecting them first, so
 * `zip(range(3), cycle(xs))` finishes: collecting would walk the endless side
 * until it ran out of memory. */
export function* zip(first: unknown, second: unknown) {
  const left = asStream(first);
  const right = asStream(second);
  while (true) {
    const a = left.next();
    const b = right.next();
    if (a.done || b.done) return;
    yield [a.value, b.value];
  }
}

export function* enumerate(iterable: unknown, start: number = 0) {
  let index = start;
  for (const element of iterable) {
    yield [index, element];
    index = index + 1;
  }
}

export function* chain(...iterables: unknown) {
  for (const iterable of iterables) {
    for (const element of iterable) yield element;
  }
}

/* One level. Flattening to the bottom needs a rule for what counts as a
 * sequence, and a string is one — so `flatten(["ab"])` would be a surprise. */
export function* flatten(iterable: unknown) {
  for (const element of iterable) {
    if (Array.isArray(element)) {
      for (const inner of element) yield inner;
    } else {
      yield element;
    }
  }
}

/* Keeps the first of each. What "each" means is `===` plus NaN matching
 * itself, which is what a Set does. */
export function* unique(iterable: unknown, keyOf: Function = null) {
  const seen = new Set();
  for (const element of iterable) {
    const key = keyOf === null ? element : keyOf(element);
    if (seen.has(key)) continue;
    seen.add(key);
    yield element;
  }
}

/* The last chunk is short rather than padded: padding invents elements, and a
 * caller that wants them can say so with `chain`. */
export function* chunk(iterable: unknown, size: number) {
  if (size < 1) throw new Error("chunk needs a size of at least 1");
  let current = [];
  for (const element of iterable) {
    current.push(element);
    if (current.length === size) {
      yield current;
      current = [];
    }
  }
  if (current.length > 0) yield current;
}

/* Overlapping pairs: [1,2,3] gives [1,2] and [2,3]. */
export function* pairwise(iterable: unknown) {
  let previous = undefined;
  let first = true;
  for (const element of iterable) {
    if (!first) yield [previous, element];
    previous = element;
    first = false;
  }
}

/* --- reading one ---------------------------------------------------------- */

export function toArray(iterable: unknown) {
  if (Array.isArray(iterable)) return iterable;
  const out = [];
  for (const element of iterable) out.push(element);
  return out;
}

export function reduce(iterable: unknown, combine: Function, initial: unknown = undefined) {
  let accumulator = initial;
  let first = initial === undefined;
  for (const element of iterable) {
    if (first) {
      accumulator = element;
      first = false;
      continue;
    }
    accumulator = combine(accumulator, element);
  }
  if (first) throw new Error("reduce of an empty sequence with no initial value");
  return accumulator;
}

export function some(iterable: unknown, test: Function): boolean {
  for (const element of iterable) {
    if (test(element)) return true;
  }
  return false;
}

export function every(iterable: unknown, test: Function): boolean {
  for (const element of iterable) {
    if (!test(element)) return false;
  }
  return true;
}

/* `undefined` when nothing matches, which is why `findIndex` exists beside it:
 * a sequence may hold an `undefined` of its own. */
export function find(iterable: unknown, test: Function) {
  for (const element of iterable) {
    if (test(element)) return element;
  }
  return undefined;
}

export function findIndex(iterable: unknown, test: Function): number {
  let index = 0;
  for (const element of iterable) {
    if (test(element)) return index;
    index = index + 1;
  }
  return -1;
}

export function length(iterable: unknown): number {
  let total = 0;
  for (const element of iterable) total = total + 1;
  return total;
}

/* A Map rather than an object, so a key can be a number or anything else that
 * is not a string — which is most of what one groups by. */
export function groupBy(iterable: unknown, keyOf: Function) {
  const groups = new Map();
  for (const element of iterable) {
    const key = keyOf(element);
    if (!groups.has(key)) groups.set(key, []);
    groups.get(key).push(element);
  }
  return groups;
}

/* Two arrays: the ones that passed, then the ones that did not. One walk,
 * where `filter` twice is two — and the second walk of a generator is empty. */
export function partition(iterable: unknown, keep: Function) {
  const kept = [];
  const rest = [];
  for (const element of iterable) {
    if (keep(element)) {
      kept.push(element);
    } else {
      rest.push(element);
    }
  }
  return [kept, rest];
}
