/* encoding.cx — the four ways bytes get written down as text.
 *
 * Base64 for anything binary that has to travel as text, hex for anything a
 * person will read, percent-encoding for anything going into a URL, and UTF-8
 * for the gap between bytes and characters.
 *
 * That last one matters more here than in most languages. A CScript string is
 * **bytes**, so `"café".length` is 5 and `text[3]` is half of an é. Everything
 * in the library that walks a string walks bytes, which is right for ASCII and
 * wrong the moment text arrives from a person. `decodeUtf8` is how to get code
 * points out; `encodeUtf8` is how to put one back.
 *
 * Nothing here is `btoa`, `atob`, `encodeURIComponent` or `TextDecoder` — none
 * of those exists in the runtime.
 */
import { fromString, toString } from "std:bytes";
import { Result } from "std:result";

/* --- base64 --------------------------------------------------------------- */

const STANDARD = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
const URL_SAFE = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";

/* Three bytes become four characters, by arithmetic rather than by shifting:
 * the language has no shift operators, and 24 bits fits in a double exactly. */
function encodeWith(bytes: array, alphabet: string, pad: boolean): string {
  const parts = [];
  let at = 0;

  while (at + 2 < bytes.length) {
    const block = bytes[at] * 65536 + bytes[at + 1] * 256 + bytes[at + 2];
    parts.push(alphabet[Math.floor(block / 262144) % 64] +
               alphabet[Math.floor(block / 4096) % 64] +
               alphabet[Math.floor(block / 64) % 64] +
               alphabet[block % 64]);
    at = at + 3;
  }

  const left = bytes.length - at;
  if (left === 1) {
    const block = bytes[at] * 65536;
    parts.push(alphabet[Math.floor(block / 262144) % 64] +
               alphabet[Math.floor(block / 4096) % 64] +
               (pad ? "==" : ""));
  } else if (left === 2) {
    const block = bytes[at] * 65536 + bytes[at + 1] * 256;
    parts.push(alphabet[Math.floor(block / 262144) % 64] +
               alphabet[Math.floor(block / 4096) % 64] +
               alphabet[Math.floor(block / 64) % 64] +
               (pad ? "=" : ""));
  }
  return parts.join("");
}

export function toBase64(bytes: array): string {
  return encodeWith(bytes, STANDARD, true);
}

/* `-` and `_` instead of `+` and `/`, and no padding — the form that survives
 * being put in a URL or a filename without being escaped again. */
export function toBase64Url(bytes: array): string {
  return encodeWith(bytes, URL_SAFE, false);
}

export function encodeBase64(text: string): string {
  return toBase64(fromString(text));
}

/* `Result` of the bytes. Base64 is input from outside — a header, a file, a
 * query parameter — so bad input is a value rather than a runtime error.
 *
 * Both alphabets are accepted and padding is optional, because a decoder that
 * refuses the URL-safe form is a decoder that fails on half the tokens in the
 * world. */
export function fromBase64(text: string) {
  const out = [];
  let block = 0;
  let held = 0;

  for (let i = 0; i < text.length; i++) {
    const character = text[i];
    if (character === "=" || character === "\n" || character === "\r" ||
        character === " ") {
      continue;
    }

    const value = base64Value(character);
    if (value < 0) {
      return Result.err("'" + character + "' at " + String(i) +
                        " is not a base64 character");
    }

    block = block * 64 + value;
    held = held + 1;
    if (held === 4) {
      out.push(Math.floor(block / 65536) % 256);
      out.push(Math.floor(block / 256) % 256);
      out.push(block % 256);
      block = 0;
      held = 0;
    }
  }

  /* A trailing group of two characters carries one byte and of three carries
   * two. A single leftover character carries nothing and cannot be right. */
  if (held === 1) return Result.err("base64 ends in a single character");
  if (held === 2) {
    /* Two characters are twelve bits, of which eight are the byte and four are
     * padding — so the data is shifted down, not up. */
    out.push(Math.floor(block / 16) % 256);
  } else if (held === 3) {
    const data = Math.floor(block / 4); /* eighteen bits, sixteen of them data */
    out.push(Math.floor(data / 256) % 256);
    out.push(data % 256);
  }
  return Result.ok(out);
}

export function decodeBase64(text: string) {
  return fromBase64(text).map((bytes: array) => toString(bytes));
}

function base64Value(character: string): number {
  const code = character.charCodeAt(0);
  if (code >= 65 && code <= 90) return code - 65;        /* A-Z */
  if (code >= 97 && code <= 122) return code - 71;       /* a-z */
  if (code >= 48 && code <= 57) return code + 4;         /* 0-9 */
  if (character === "+" || character === "-") return 62;
  if (character === "/" || character === "_") return 63;
  return -1;
}

/* --- hex ------------------------------------------------------------------ */

const HEX = "0123456789abcdef";

export function toHex(bytes: array, upper: boolean = false): string {
  const parts = [];
  for (const byte of bytes) {
    const pair = HEX[Math.floor(byte / 16)] + HEX[byte % 16];
    parts.push(upper ? pair.toUpperCase() : pair);
  }
  return parts.join("");
}

export function fromHex(text: string) {
  const trimmed = text.startsWith("0x") || text.startsWith("0X") ? text.slice(2) : text;
  if (trimmed.length % 2 !== 0) {
    return Result.err("hex has an odd number of digits");
  }

  const out = [];
  for (let i = 0; i < trimmed.length; i = i + 2) {
    const high = hexValue(trimmed.charCodeAt(i));
    const low = hexValue(trimmed.charCodeAt(i + 1));
    if (high < 0 || low < 0) {
      return Result.err("'" + trimmed.slice(i, i + 2) + "' at " + String(i) +
                        " is not a hex pair");
    }
    out.push(high * 16 + low);
  }
  return Result.ok(out);
}

function hexValue(code: number): number {
  if (code >= 48 && code <= 57) return code - 48;
  if (code >= 97 && code <= 102) return code - 87;
  if (code >= 65 && code <= 70) return code - 55;
  return -1;
}

/* --- percent-encoding ----------------------------------------------------- */

/* The unreserved set from RFC 3986: letters, digits, and `-._~`. Everything
 * else is escaped, which is what `encodeURIComponent` does and what a query
 * value needs — `encodeURI`'s laxer set is not offered, because choosing
 * between the two wrongly is the usual bug. */
function isUnreserved(code: number): boolean {
  if (code >= 65 && code <= 90) return true;
  if (code >= 97 && code <= 122) return true;
  if (code >= 48 && code <= 57) return true;
  return code === 45 || code === 46 || code === 95 || code === 126;
}

export function percentEncode(text: string): string {
  const parts = [];
  for (let i = 0; i < text.length; i++) {
    const code = text.charCodeAt(i);
    if (isUnreserved(code)) {
      parts.push(text[i]);
      continue;
    }
    parts.push("%" + HEX[Math.floor(code / 16)].toUpperCase() +
               HEX[code % 16].toUpperCase());
  }
  return parts.join("");
}

/* `+` is a space here, because that is what a form body means by it and a
 * decoder that ignores it silently mangles every query string it is given. */
export function percentDecode(text: string) {
  const out = [];
  let i = 0;
  while (i < text.length) {
    const character = text[i];
    if (character === "+") {
      out.push(32);
      i = i + 1;
      continue;
    }
    if (character !== "%") {
      out.push(text.charCodeAt(i));
      i = i + 1;
      continue;
    }
    if (i + 2 >= text.length) {
      return Result.err("a % at " + String(i) + " with no digits after it");
    }
    const high = hexValue(text.charCodeAt(i + 1));
    const low = hexValue(text.charCodeAt(i + 2));
    if (high < 0 || low < 0) {
      return Result.err("'%" + text.slice(i + 1, i + 3) + "' at " + String(i) +
                        " is not a percent escape");
    }
    out.push(high * 16 + low);
    i = i + 3;
  }
  return Result.ok(toString(out));
}

/* --- UTF-8 ---------------------------------------------------------------- */

/* A code point as its bytes. */
export function encodeUtf8(code: number): string {
  if (code < 0 || code > 1114111 || code !== Math.floor(code)) {
    throw new Error("not a code point: " + String(code));
  }
  if (code < 128) return String.fromCharCode(code);
  if (code < 2048) {
    return String.fromCharCode(192 + Math.floor(code / 64)) +
           String.fromCharCode(128 + code % 64);
  }
  if (code < 65536) {
    return String.fromCharCode(224 + Math.floor(code / 4096)) +
           String.fromCharCode(128 + Math.floor(code / 64) % 64) +
           String.fromCharCode(128 + code % 64);
  }
  return String.fromCharCode(240 + Math.floor(code / 262144)) +
         String.fromCharCode(128 + Math.floor(code / 4096) % 64) +
         String.fromCharCode(128 + Math.floor(code / 64) % 64) +
         String.fromCharCode(128 + code % 64);
}

/* The code points of a string, as numbers.
 *
 * This is the function that makes text work at all: `"café".length` is 5
 * because the é is two bytes, and `decodeUtf8(text).length` is 4 because it is
 * one character. Answers a Result, because text from outside may not be valid
 * UTF-8 and a decoder that guesses produces mojibake nobody can trace. */
export function decodeUtf8(text: string) {
  const out = [];
  let i = 0;
  while (i < text.length) {
    const first = text.charCodeAt(i);

    if (first < 128) {
      out.push(first);
      i = i + 1;
      continue;
    }

    let width = 0;
    let code = 0;
    if (first >= 192 && first < 224) {
      width = 2;
      code = first - 192;
    } else if (first >= 224 && first < 240) {
      width = 3;
      code = first - 224;
    } else if (first >= 240 && first < 248) {
      width = 4;
      code = first - 240;
    } else {
      return Result.err("byte " + String(first) + " at " + String(i) +
                        " cannot start a UTF-8 sequence");
    }

    if (i + width > text.length) {
      return Result.err("a " + String(width) + "-byte sequence at " + String(i) +
                        " runs past the end");
    }
    for (let step = 1; step < width; step++) {
      const next = text.charCodeAt(i + step);
      if (next < 128 || next >= 192) {
        return Result.err("byte " + String(next) + " at " + String(i + step) +
                          " is not a continuation");
      }
      code = code * 64 + (next - 128);
    }

    out.push(code);
    i = i + width;
  }
  return Result.ok(out);
}

/* The characters of a string, as strings — what `[...text]` would give in a
 * language whose strings were not bytes. */
export function characters(text: string) {
  return decodeUtf8(text).map((codes: array) => {
    const out = [];
    for (const code of codes) out.push(encodeUtf8(code));
    return out;
  });
}

/* How many characters, as opposed to how many bytes. */
export function characterLength(text: string) {
  return decodeUtf8(text).map((codes: array) => codes.length);
}

/* Whether the bytes are valid UTF-8 at all — the question to ask before
 * treating something read from a file as text. */
export function isValidUtf8(text: string): boolean {
  return decodeUtf8(text).isOk;
}
