// CScript keeps TypeScript's syntax but removes JavaScript's traps. Every line
// below behaves differently here than it would in plain JavaScript — and every
// difference is an error you can see, never a silent change of meaning.

// typeof null is "object" in JavaScript. That is a bug from 1995.
console.log(typeof null);          // "null"

// Types are checked before the program runs, with or without annotations.
const count: number = 41;
console.log(count + 1);

// These are all compile errors. Uncomment any of them to see the message:
//   console.log(1 == "1");        // '==' coerces; use '==='
//   console.log(true * 3);        // operand of '*' must be a number
//   console.log(count === "41");  // the types can never match
//   let bad: number = "text";     // cannot assign string to a number
//   var old = 1;                  // 'var' is function-scoped and hoisted

// Conversions are explicit rather than implicit.
console.log(Number("42") + 1);
console.log(String(42) + "!");
console.log(Boolean(""));

// The standard library is part of the language, not an object lying around.
// JavaScript lets you write `Math.PI = 3` or replace `console.log`, and the
// damage shows up somewhere else entirely. Both are errors here:
//   Math.PI = 3;                  // 'Math.PI' is a built-in
//   console.log = null;           // 'console.log' is a built-in
// A user object with the same key is untouched.
const mine = { PI: 3 };
mine.PI = 3.14159;
console.log(mine.PI);

// `any` is the escape hatch back into dynamic typing.
let loose: any = 1;
loose = "now a string";
console.log(typeof loose);
