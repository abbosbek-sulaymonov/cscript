{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CScript",
  "scopeName": "source.cscript",
  "patterns": [
    { "include": "#comment" },
    { "include": "#annotation" },
    { "include": "#string" },
    { "include": "#template" },
    { "include": "#regex" },
    { "include": "#number" },
    { "include": "#declaration" },
    { "include": "#keyword" },
    { "include": "#constant" },
    { "include": "#operator" },
    { "include": "#call" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cscript",
          "begin": "//",
          "end": "$"
        },
        {
          "name": "comment.block.cscript",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },

    "annotation": {
      "comment": "`: number` and `): string {`. CScript's types are the one thing here that is not JavaScript, so they get a scope of their own rather than borrowing one.",
      "patterns": [
        {
          "match": "(:)\\s*\\b(number|string|boolean|bigint|object|null|undefined|any)\\b",
          "captures": {
            "1": { "name": "punctuation.separator.type.cscript" },
            "2": { "name": "entity.name.type.primitive.cscript" }
          }
        }
      ]
    },

    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.cscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "include": "#escape" }]
        },
        {
          "name": "string.quoted.single.cscript",
          "begin": "'",
          "end": "'",
          "patterns": [{ "include": "#escape" }]
        }
      ]
    },

    "escape": {
      "name": "constant.character.escape.cscript",
      "match": "\\\\(u\\{[0-9A-Fa-f]+\\}|u[0-9A-Fa-f]{4}|x[0-9A-Fa-f]{2}|.)"
    },

    "template": {
      "name": "string.template.cscript",
      "begin": "`",
      "end": "`",
      "patterns": [
        { "include": "#escape" },
        {
          "name": "meta.embedded.expression.cscript",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.cscript" } },
          "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.cscript" } },
          "patterns": [{ "include": "$self" }]
        }
      ]
    },

    "regex": {
      "comment": "Only where a value is wanted, so that division is not mistaken for one.",
      "name": "string.regexp.cscript",
      "begin": "(?<=[=(,:\\[!&|?{;+\\-*/%]|^|\\breturn\\b|\\bcase\\b)\\s*(/)(?![/*])",
      "end": "(/)([dgimsuvy]*)",
      "beginCaptures": { "1": { "name": "punctuation.definition.string.begin.cscript" } },
      "endCaptures": {
        "1": { "name": "punctuation.definition.string.end.cscript" },
        "2": { "name": "keyword.other.flag.cscript" }
      },
      "patterns": [
        { "name": "constant.character.escape.cscript", "match": "\\\\." },
        {
          "name": "meta.group.cscript",
          "match": "\\(\\?(<[A-Za-z_$][\\w$]*>|<=|<!|=|!|:)"
        }
      ]
    },

    "number": {
      "patterns": [
        {
          "comment": "A BigInt is a number with an `n` after it, and is worth telling apart at a glance because it is a different type.",
          "name": "constant.numeric.bigint.cscript",
          "match": "\\b(0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|\\d[\\d_]*)n\\b"
        },
        {
          "name": "constant.numeric.cscript",
          "match": "\\b(0[xX][0-9a-fA-F_]+|0[oO][0-7_]+|0[bB][01_]+|(\\d[\\d_]*)?\\.?\\d[\\d_]*([eE][+-]?\\d+)?)\\b"
        }
      ]
    },

    "declaration": {
      "patterns": [
        {
          "match": "\\b(function)\\s*(\\*)?\\s+([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": { "name": "storage.type.function.cscript" },
            "2": { "name": "keyword.operator.generator.cscript" },
            "3": { "name": "entity.name.function.cscript" }
          }
        },
        {
          "match": "\\b(class)\\s+([A-Za-z_$][\\w$]*)(?:\\s+(extends)\\s+([A-Za-z_$][\\w$]*))?",
          "captures": {
            "1": { "name": "storage.type.class.cscript" },
            "2": { "name": "entity.name.class.cscript" },
            "3": { "name": "storage.modifier.cscript" },
            "4": { "name": "entity.other.inherited-class.cscript" }
          }
        },
        {
          "match": "\\b(let|const|var)\\s+([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": { "name": "storage.type.cscript" },
            "2": { "name": "variable.other.declaration.cscript" }
          }
        }
      ]
    },

    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.cscript",
          "match": "\\b(if|else|for|while|do|switch|case|default|break|continue|return|throw|try|catch|finally|yield|await|of|in|new|delete|typeof|void|instanceof)\\b"
        },
        {
          "name": "storage.type.cscript",
          "match": "\\b(function|class|let|const|var|async|static|get|set|extends|super)\\b"
        },
        {
          "name": "keyword.control.import.cscript",
          "match": "\\b(import|export|from|as)\\b"
        },
        { "name": "variable.language.this.cscript", "match": "\\bthis\\b" }
      ]
    },

    "constant": {
      "patterns": [
        { "name": "constant.language.cscript", "match": "\\b(true|false|null|undefined|NaN|Infinity)\\b" },
        {
          "name": "support.class.builtin.cscript",
          "match": "\\b(console|Math|JSON|Object|Array|Number|String|Boolean|Symbol|BigInt|Promise|Map|Set|WeakMap|WeakSet|Date|Error|AggregateError|RegExp)\\b"
        },
        { "name": "variable.other.private.cscript", "match": "#[A-Za-z_$][\\w$]*" }
      ]
    },

    "operator": {
      "name": "keyword.operator.cscript",
      "match": "(=>|\\?\\?=|\\|\\|=|&&=|\\*\\*=|===|!==|<=|>=|\\?\\?|\\?\\.|\\+\\+|--|\\*\\*|&&|\\|\\||[+\\-*/%<>=!?:]|\\.\\.\\.)"
    },

    "call": {
      "match": "\\b([A-Za-z_$][\\w$]*)\\s*(?=\\()",
      "captures": { "1": { "name": "entity.name.function.call.cscript" } }
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.cscript", "match": ";" },
        { "name": "punctuation.separator.cscript", "match": "[,.]" },
        { "name": "punctuation.section.brackets.cscript", "match": "[{}()\\[\\]]" }
      ]
    }
  }
}
